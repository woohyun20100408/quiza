rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function quizOwner() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
    match /users/{uid} {
      allow read, write: if owner(uid);
      match /favorites/{quizId} { allow read, write: if owner(uid); }
      match /playHistory/{historyId} { allow read, write: if owner(uid); }
    }
    match /quizSets/{quizId} {
      allow read: if resource.data.visibility == 'public' || quizOwner();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if quizOwner() && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if quizOwner();
      match /questions/{questionId} {
        function parent() { return get(/databases/$(database)/documents/quizSets/$(quizId)); }
        allow read: if parent().data.visibility == 'public' || (signedIn() && parent().data.ownerUid == request.auth.uid);
        allow create, update, delete: if signedIn() && parent().data.ownerUid == request.auth.uid;
      }
      match /likes/{uid} { allow read: if true; allow create, delete: if owner(uid); allow update: if false; }
    }
  }
}
