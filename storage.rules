rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /quiz-covers/{quizId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/quizSets/$(quizId)).data.ownerUid == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
